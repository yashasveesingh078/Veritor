# Copy to .env at the repository root. The backend reads these values.
# The defaults below match backend/app/config.py. Never commit real secrets.

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
VERITOR_LOG_LEVEL=INFO

# Browser origins allowed to call the API, as a JSON array.
VERITOR_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local Ollama server. All models run locally.
VERITOR_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Sorts flagged differences by urgency.
VERITOR_TRIAGE_MODEL=phi4-mini

# Explains what flagged code changes do.
VERITOR_EXPLAIN_MODEL=qwen2.5-coder:7b

# Package registry limits. A deadline caps a whole request, however slowly data arrives.
VERITOR_REGISTRY_CONNECT_TIMEOUT_SECONDS=5
VERITOR_REGISTRY_READ_TIMEOUT_SECONDS=30
VERITOR_REGISTRY_METADATA_DEADLINE_SECONDS=60
VERITOR_REGISTRY_DOWNLOAD_DEADLINE_SECONDS=300
VERITOR_REGISTRY_MAX_METADATA_BYTES=134217728
VERITOR_REGISTRY_MAX_ARTIFACT_BYTES=268435456
VERITOR_REGISTRY_MAX_SOURCE_ARCHIVE_BYTES=1073741824

# Archive extraction limits. An archive over any limit is rejected as a whole.
VERITOR_EXTRACTION_MAX_ARCHIVE_BYTES=1073741824
VERITOR_EXTRACTION_MAX_TOTAL_BYTES=4294967296
VERITOR_EXTRACTION_MAX_FILE_BYTES=1073741824
VERITOR_EXTRACTION_MAX_ENTRIES=200000
VERITOR_EXTRACTION_MAX_COMPRESSION_RATIO=200
VERITOR_EXTRACTION_DEADLINE_SECONDS=300

# Comparison limits. A file over a limit keeps its hashes but has no complete text diff.
VERITOR_COMPARISON_MAX_DIFF_FILE_BYTES=1048576
VERITOR_COMPARISON_MAX_DIFF_LINES=20000
VERITOR_COMPARISON_MAX_DIFF_OUTPUT_BYTES=262144
VERITOR_COMPARISON_MAX_TOTAL_DIFF_BYTES=67108864

# Static analysis limits. A file that is skipped is reported as a gap, never as clean.
VERITOR_ANALYSIS_MAX_FILE_BYTES=8388608
VERITOR_ANALYSIS_DEADLINE_SECONDS=300

# Time allowed to verify an npm provenance attestation with Sigstore.
VERITOR_PROVENANCE_TIMEOUT_SECONDS=60

# Optional GitHub token. It needs no scopes, and raises the API limit from 60 requests
# an hour. It is only used to check commits that have no matching tag.
VERITOR_GITHUB_TOKEN=
